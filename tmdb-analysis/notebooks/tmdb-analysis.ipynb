   "source": [
    "# Keep only rows with at least 10 non-NaN values\n",
    "def filter_non_nan_rows(df):\n",
    "    \"\"\"\n",
    "    Keep only rows with at least 10 non-NaN values.\n",
    "    \"\"\"\n",
    "    return df[df.notna().sum(axis=1) >= 10]"
   ]
  },
