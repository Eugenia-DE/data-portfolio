   "id": "99a5b093-3b63-4b12-af3b-bd6ad0210def",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter only 'Released' movies and drop 'status' column\n",
    "def filter_released_movies(df):\n",
    "    \"\"\"\n",
    "    Keep only 'Released' movies and drop 'status' column.\n",
    "    \"\"\"\n",
    "    df = df[df['status'] == 'Released']\n",
    "    df.drop(columns=['status'], inplace=True)\n",
    "    return df"
   ]
  },
