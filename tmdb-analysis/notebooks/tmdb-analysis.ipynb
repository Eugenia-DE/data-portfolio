   "id": "a8ce918b-ae72-4b4d-99c5-ff75323cc21e",
   "metadata": {},
   "outputs": [],
   "source": [
    "filtered_tmdb_data = filter_non_nan_rows(clean_tmdb_data)"
   ]
  },
  {
