   "source": [
    "def view_placeholder_entries(df, columns, placeholder='No Data'):\n",
    "    \"\"\"\n",
    "    Return rows where specified columns contain a given placeholder.\n",
    "    \"\"\"\n",
    "    condition = False\n",
    "    for col in columns:\n",
    "        condition |= (df[col] == placeholder)\n",
    "    return df[condition][['title'] + columns]"
   ]
  },
