   "source": [
    "# Import necessary libraries\n",
    "import pandas as pd\n",
    "import requests \n",
    "import warnings\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "2dae9b23-1b2f-4509-a7d7-f04e050b5fa6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define the TMDB base URL, API key, and details of movie IDs \n",
    "# Replace your_api_key before running\n",
    "api_key = \"Replace with your API key"   \n",
    "base_url = \"https://api.themoviedb.org/3/movie/\"\n",
    "movie_ids = [0, 299534, 19995, 140607, 299536, 597, 135397, 420818, 24428, 168259, 99861, 284054, 12445, 181808, 330457, 351286, 109445, 321612, 260513]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "72450c16-9427-45a6-b408-0c83f8759dc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fetch movie data from TMDB API\n",
    "def fetch_tmdb_data(movie_ids, api_key, base_url):\n",
    "    \"\"\"\n",
    "    Fetch movie info from TMDB for the list of movie IDs.\n",
    "    Returns a DataFrame with extracted movie data.\n",
    "    \"\"\"\n",
    "    all_movies = []\n",
    "    base_url = \"https://api.themoviedb.org/3/movie/\"\n",
    "\n",
    "    for movie_id in movie_ids:\n",
    "        if movie_id == 0:\n",
    "            continue\n",
    "\n",
    "        url = f\"{base_url}{movie_id}?api_key={api_key}&language=en-US&append_to_response=credits\"\n",
    "        try:\n",
    "            response = requests.get(url)\n",
    "            response.raise_for_status()\n",
    "            tmdb_data = response.json()\n",
    "\n",
    "            if 'id' not in tmdb_data:\n",
    "                warnings.warn(f\"Movie ID {movie_id} has no data.\")\n",
    "                continue\n",
    "\n",
    "            all_movies.append(tmdb_data)\n",
    "\n",
    "        except requests.exceptions.HTTPError as http_err:\n",
    "            warnings.warn(f\"HTTP error for ID {movie_id}: {http_err}\")\n",
    "            continue\n",
    "\n",
    "    return pd.DataFrame(all_movies)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "87fa0685-ce74-45de-975f-77e6e1322182",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fetch movie data\n",
    "tmdb_data = fetch_tmdb_data(movie_ids, api_key, base_url)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "a2dbdccb-a02c-4fb3-bc09-44dc9aeba67f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Parse JSON column to get the 'credits' column\n",
    "def parse_credits_column(df):\n",
    "    \"\"\"\n",
    "    Converts the 'credits' column from JSON string to dictionary\n",
    "    \"\"\"\n",
    "    df['credits'] = df['credits'].apply(lambda x: json.loads(x) if isinstance(x, str) else x)\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "82693043-90cc-4285-9b9a-db7de58944ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract cast and crew details from the credits dictionary\n",
    "def extract_cast_crew_details(credits_dict):\n",
    "    \"\"\"\n",
    "    Extracts top 5 cast names, cast size, director name, and crew size from credits dictionary.\n",
    "    \"\"\"\n",
    "    if not isinstance(credits_dict, dict):\n",
    "        return pd.Series([None, None, None, None], index=['cast', 'cast_size', 'director', 'crew_size'])\n",
    "\n",
    "    cast_list = credits_dict.get('cast', [])\n",
    "    crew_list = credits_dict.get('crew', [])\n",
    "\n",
    "    # Get top 5 cast names\n",
    "    cast_names = [member['name'] for member in cast_list[:5] if 'name' in member]\n",
    "\n",
    "    # Get directors\n",
    "    directors = [member['name'] for member in crew_list if member.get('job') == 'Director']\n",
    "\n",
    "    return pd.Series([\n",
    "        '|'.join(cast_names),\n",
    "        len(cast_list),\n",
    "        directors[0] if directors else None,\n",
    "        len(crew_list)\n",
    "    ], index=['cast', 'cast_size', 'director', 'crew_size'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "31e7cefb-c418-4282-8254-0a46e3ee1488",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extracts the 'credits' details into the dataframe\n",
    "def process_cast_crew_data(df):\n",
    "    \"\"\"\n",
    "    Parses the 'credits' column and extracts cast and crew details into the dataframe.\n",
    "    \"\"\"\n",
    "    df = parse_credits_column(df)\n",
    "    cast_crew_df = df['credits'].apply(extract_cast_crew_details)\n",
    "    df = pd.concat([df, cast_crew_df], axis=1)\n",
    "    return df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "8d576199-75f3-4637-ad35-f5e3754cc630",
   "metadata": {},
   "outputs": [],
   "source": [
    "tmdb_data = process_cast_crew_data(tmdb_data)"
   ]
