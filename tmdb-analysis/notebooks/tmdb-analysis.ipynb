   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_revenue_vs_budget(df):\n",
    "    plt.scatter(df['budget'], df['revenue'])\n",
    "    plt.title('Revenue vs. Budget Trends')\n",
    "    plt.xlabel('Budget')\n",
    "    plt.ylabel('Revenue')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 77,
   "id": "c6f3cbdb-aeac-4b49-a5e5-6b2556a4887e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_roi_distribution_by_genre(df):\n",
    "    df['roi'] = df['revenue'] / df['budget']\n",
    "    df_genre_roi = df.groupby('genres')['roi'].mean()\n",
    "    df_genre_roi.plot(kind='bar')\n",
    "    plt.title('ROI Distribution by Genre')\n",
    "    plt.xlabel('Genre')\n",
    "    plt.ylabel('Average ROI')\n",
    "    plt.show()"
   ]
  },
